{
    "name": "ybwork-shaderlab",
    "displayName": "Beautify ShaderLab",
    "description": "ShaderLab高亮格式化插件",
    "version": "0.1.0",
    "publisher": "ybwork",
    "author": {
        "name": "ybwork",
        "url": "https://ybwork.cn:12343/ybwork",
        "email": "ybworkcn@qq.com"
    },
    "icon": "shaderlab.png",
    "repository": {
        "url": "https://ybwork.cn:12343/vscode-extension/shaderlab.git"
    },
    "keywords": [
        "vscode",
        "plugin",
        "format",
        "shaderlab",
        "unity"
    ],
    "engines": {
        "vscode": "^1.84.0"
    },
    "categories": [
        "Programming Languages",
        "Formatters"
    ],
    "activationEvents": [
        "onLanguage:shaderlab",
        "onLanguage:hlsl"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ybwork-shaderlab.activate",
                "title": "Activate Beautify ShaderLab",
                "category": "ShaderLab"
            },
            {
                "command": "ybwork-shaderlab.format",
                "title": "Format ShaderLab",
                "category": "ShaderLab"
            }
        ],
        "menus": {
            "editor/context": []
        },
        "keybindings": [],
        "languages": [
            {
                "id": "shaderlab",
                "extensions": [
                    ".shader"
                ]
            },
            {
                "id": "hlsl",
                "extensions": [
                    ".cginc",
                    ".hlsl",
                    ".hlsli",
                    ".compute"
                ]
            }
        ],
        "grammars": [
            {
                "language": "shaderlab",
                "scopeName": "source.shaderlab",
                "path": "./syntaxes/shaderlab.tmLanguage.json"
            },
            {
                "language": "hlsl",
                "scopeName": "source.hlsl",
                "path": "./syntaxes/hlsl.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Beautify ShaderLab",
                "properties": {}
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint scripts --ext .ts",
        "test": "node ./out/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.4.5",
        "@types/vscode": "^1.84.1",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.1.3",
        "@vscode/vsce": "^2.15.0"
    }
}
